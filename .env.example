# ==============================================================================
# Embedo Backend — Environment Template
# Copy to .env. In production, EVERY secret below must be a real random value.
# Generate secrets with:  openssl rand -hex 32
# ==============================================================================

# Server & Environment  (deploy.sh refuses to deploy unless NODE_ENV=production)
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/embedo_dev

# Redis (cache, rate limiting, BullMQ, moderation strike windows)
REDIS_URL=redis://localhost:6379

# JWT — access tokens are signed with this; refresh tokens are random bytes hashed in the DB.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# Rate limiting (global per-IP limiter; other limiters are fixed-policy)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
SESSION_CREATE_DAILY_MAX_PER_IP=50

# AI providers — OPENAI_API_KEY is REQUIRED in production (Sol/Luna, embeddings, moderation)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Google Sign-In — REQUIRED for /auth/google (audience verification). Unset = Google login disabled.
GOOGLE_CLIENT_ID=

# Model routing
ROUTE_CACHE_TTL_SECONDS=60

# Moderation. FAIL_MODE default: closed in production, open elsewhere.
# MODERATION_FAIL_MODE=closed
MODERATION_TIER3_ENABLED=true
MODERATION_STRIKE_LIMIT=3
MODERATION_STRIKE_WINDOW_SECONDS=3600
MODERATION_SUSPENSION_SECONDS=86400

# Operator dashboards (Bull Board at /admin/queues, Swagger in production). Admin JWT also accepted.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Outbound email (password reset). Unset = reset emails are NOT sent (logged as an error).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Embedo.ai <no-reply@embedo.ai>

# Datasheet ingestion hardening
# INGEST_ALLOWED_DOMAINS=.ti.com,.analog.com,.nxp.com,.st.com,.espressif.com
INGEST_MAX_PDF_MB=25
# INGEST_USER_AGENT=EmbedoBot/1.0 (+https://embedo.ai; datasheet-indexer)

# Admin bootstrap (seed only; never stored in the app env after first run)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Cloudflare R2 (optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=embedo-exports
R2_PUBLIC_URL=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# docker-compose.prod.yml (required, no defaults)
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
