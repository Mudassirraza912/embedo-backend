datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.VarChar(255)
  hashedPassword    String?   @map("hashed_password") @db.VarChar(255)
  role              String    @default("user") @db.VarChar(20)
  expertiseLevel    String?   @map("expertise_level") @db.VarChar(50)
  dataConsent       Boolean   @default(false) @map("data_consent")
  dataConsentDate   DateTime? @map("data_consent_date") @db.Timestamp(6)
  /// Admin override of the derived plan: "free" or "paid". Null = derive from subscriptions.
  planOverride      String?   @map("plan_override") @db.VarChar(20)
  /// Per-user limit overrides, e.g. {"messagesPerSession": 50}. A missing key inherits the plan's value.
  limitOverrides    Json?     @map("limit_overrides")
  moderationStrikes Int       @default(0) @map("moderation_strikes")
  suspendedAt       DateTime? @map("suspended_at") @db.Timestamp(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  authIdentities     AuthIdentity[]
  refreshTokens      RefreshToken[]
  subscriptions      Subscription[]
  designSessions     DesignSession[]
  chatMessages       ChatMessage[]
  auditLogs          AuditLog[]
  moderationEvents   ModerationEvent[]
  modelRoutesUpdated ModelRoute[]

  @@map("users")
}

model AuthIdentity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId], map: "auth_identities_user_idx")
  @@map("auth_identities")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("TokenReplacement", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("TokenReplacement")

  @@unique([tokenHash], map: "refresh_tokens_token_hash_key")
  @@index([userId], map: "refresh_tokens_user_idx")
  @@map("refresh_tokens")
}

model DesignSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  anonSessionToken   String?   @map("anon_session_token") @db.VarChar(255)
  intentText         String    @map("intent_text") @db.Text
  /// AI-generated, profanity-free project title. Never derived from raw user text, which can
  /// contain abusive language (see conversation-router.service.ts).
  title              String?   @db.VarChar(120)
  intentStructured   Json?     @map("intent_structured")
  designGraph        Json?     @map("design_graph")
  domain             String?   @db.VarChar(100)
  applicationContext String?   @map("application_context") @db.VarChar(100)
  architecture       Json?
  parentSessionId    String?   @map("parent_session_id") @db.Uuid
  /// PENDING | PROCESSING | CLARIFICATION_REQUIRED | DONE | FAILED | SYSTEM
  /// Enforced by the design_sessions_status_check constraint (see migrations).
  status             String    @default("PENDING") @db.VarChar(50)
  consentAtCreation  Boolean   @default(false) @map("consent_at_creation")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user             User?             @relation(fields: [userId], references: [id])
  parentSession    DesignSession?    @relation("SessionIterations", fields: [parentSessionId], references: [id])
  childSessions    DesignSession[]   @relation("SessionIterations")
  versions         SessionVersion[]
  proposals        DesignProposal[]
  chatMessages     ChatMessage[]
  aiCalls          AiCall[]
  userFeedback     UserFeedback[]
  designOutcome    DesignOutcome?
  moderationEvents ModerationEvent[]
  privateHardware  HardwareEntity[]

  @@index([userId], map: "design_sessions_user_idx")
  @@index([anonSessionToken], map: "design_sessions_anon_idx")
  @@index([status], map: "design_sessions_status_idx")
  @@index([deletedAt], map: "design_sessions_deleted_idx")
  @@map("design_sessions")
}

model SessionVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  versionTag     String   @map("version_tag") @db.VarChar(20) // e.g. "v1.0", "v1.1", "v1.2"
  changeSummary  String   @map("change_summary") @db.Text
  appliedChanges String[] @map("applied_changes")
  designGraph    Json     @map("design_graph")
  architecture   Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  session DesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, versionNumber], map: "session_versions_session_version_unique")
  @@index([sessionId], map: "session_versions_session_idx")
  @@map("session_versions")
}

/// A revision built while the user's apply mode was "manual": the full design is kept here and the
/// chat shows a "Proposed change" card. Approving saves it as the next version (only while the
/// design is still at baseVersionTag); any other new version makes a pending proposal outdated.
model DesignProposal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String    @map("session_id") @db.Uuid
  /// pending | approved | rejected | outdated (design_proposals_status_check)
  status         String    @default("pending") @db.VarChar(20)
  /// The version this was built on; null only if the design had no tag.
  baseVersionTag String?   @map("base_version_tag") @db.VarChar(20)
  /// The version it became, once approved.
  versionTag     String?   @map("version_tag") @db.VarChar(20)
  changeSummary  String    @map("change_summary") @db.Text
  appliedChanges String[]  @map("applied_changes")
  designGraph    Json      @map("design_graph")
  architecture   Json
  /// The version card to post on approval: { content, metadata } with VERSION_TAG_PLACEHOLDER for the tag.
  card           Json
  messageId      String?   @map("message_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  decidedAt      DateTime? @map("decided_at") @db.Timestamp(6)

  session DesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status], map: "design_proposals_session_status_idx")
  @@map("design_proposals")
}

model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  role      String   @db.VarChar(20) // "user", "assistant", "system"
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  session DesignSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User?         @relation(fields: [userId], references: [id])

  @@index([sessionId], map: "chat_messages_session_idx")
  @@index([userId], map: "chat_messages_user_idx")
  @@map("chat_messages")
}

model AiCall {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  taskCase      String   @map("task_case") @db.Char(1)
  modelProvider String   @map("model_provider") @db.VarChar(50)
  modelName     String   @map("model_name") @db.VarChar(100)
  prompt        String   @db.Text
  response      String   @db.Text
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  cachedTokens  Int?     @map("cached_tokens")
  costUsd       Decimal? @map("cost_usd") @db.Decimal(10, 6)
  latencyMs     Int?     @map("latency_ms")
  retryCount    Int      @default(0) @map("retry_count")
  schemaPass    Boolean? @map("schema_pass")
  errorMessage  String?  @map("error_message") @db.Text
  /// easy | medium | hard (prompt-classifier.ts); null for task cases that are not classified.
  promptDifficulty String? @map("prompt_difficulty") @db.VarChar(10)
  difficultyScore  Int?    @map("difficulty_score") @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  session      DesignSession  @relation(fields: [sessionId], references: [id])
  userFeedback UserFeedback[]

  @@index([sessionId], map: "ai_calls_session_idx")
  @@index([createdAt], map: "ai_calls_created_idx")
  @@map("ai_calls")
}

model UserFeedback {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String   @map("session_id") @db.Uuid
  aiCallId            String?  @map("ai_call_id") @db.Uuid
  action              String   @db.VarChar(50)
  modifications       Json?
  rating              Int?
  notes               String?  @db.Text
  timeToActionSeconds Int?     @map("time_to_action_seconds")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  session DesignSession @relation(fields: [sessionId], references: [id])
  aiCall  AiCall?       @relation(fields: [aiCallId], references: [id])

  @@index([sessionId], map: "user_feedback_session_idx")
  @@map("user_feedback")
}

model DesignOutcome {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String   @unique @map("session_id") @db.Uuid
  exported            Boolean  @default(false)
  exportFormat        String?  @map("export_format") @db.VarChar(50)
  exportFileKey       String?  @map("export_file_key") @db.VarChar(500)
  fabricated          Boolean?
  workedFirstTime     Boolean? @map("worked_first_time")
  iterationsToWorking Int?     @map("iterations_to_working")
  feedbackNotes       String?  @map("feedback_notes") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  session DesignSession @relation(fields: [sessionId], references: [id])

  @@map("design_outcomes")
}

model Component {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partNumber    String?                      @unique @map("part_number") @db.VarChar(255)
  manufacturer  String?                      @db.VarChar(255)
  category      String?                      @db.VarChar(100)
  specs         Json?
  datasheetUrl  String?                      @map("datasheet_url") @db.Text
  source        String?                      @db.VarChar(50)
  lastRefreshed DateTime?                    @map("last_refreshed") @db.Timestamp(6)
  embedding     Unsupported("vector(1536)")?

  datasheetChunks DatasheetChunk[]

  @@index([partNumber], map: "components_part_number_idx")
  @@map("components")
}

model DatasheetChunk {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  componentId   String?                      @map("component_id") @db.Uuid
  chunkText     String?                      @map("chunk_text") @db.Text
  chunkMetadata Json?                        @map("chunk_metadata")
  pageNumber    Int?                         @map("page_number")
  embedding     Unsupported("vector(1536)")?

  component Component? @relation(fields: [componentId], references: [id])

  @@index([componentId], map: "datasheet_chunks_component_idx")
  @@map("datasheet_chunks")
}

model KnowledgeChunk {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType    String                       @map("source_type") @db.VarChar(50) // "datasheet", "forum", "app_note", "community"
  sourceUrl     String?                      @map("source_url") @db.Text
  title         String?                      @db.VarChar(500)
  chunkText     String                       @map("chunk_text") @db.Text
  chunkMetadata Json?                        @map("chunk_metadata")
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([sourceType], map: "knowledge_chunks_source_type_idx")
  @@map("knowledge_chunks")
}

model ModelRoute {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskCase      String   @map("task_case") @db.Char(1)
  domain        String?  @db.VarChar(100)
  modelProvider String   @map("model_provider") @db.VarChar(50)
  modelName     String   @map("model_name") @db.VarChar(100)
  temperature   Decimal  @default(0.20) @db.Decimal(3, 2)
  maxTokens     Int      @default(4096) @map("max_tokens")
  isActive      Boolean  @default(true) @map("is_active")
  updatedBy     String?  @map("updated_by") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  updater User? @relation(fields: [updatedBy], references: [id])

  @@unique([taskCase, domain])
  @@map("model_routes")
}

/// Model per prompt difficulty for the classified task cases (A, R, E). Edited from
/// admin.embedo.ai (AI Operations → Routing & Fallbacks) through a writer role limited to this
/// table. No row / inactive row = the task case's model_routes row is used.
model DifficultyModelRoute {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskCase      String   @map("task_case") @db.Char(1)
  difficulty    String   @db.VarChar(10)
  modelProvider String   @map("model_provider") @db.VarChar(50)
  modelName     String   @map("model_name") @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")
  /// Admin portal staff email (not a product user).
  updatedBy     String?  @map("updated_by") @db.VarChar(320)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([taskCase, difficulty])
  @@map("difficulty_model_routes")
}

model Subscription {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  stripeCustomerId     String    @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id") @db.VarChar(255)
  plan                 String    @db.VarChar(50)
  status               String    @db.VarChar(50)
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "subscriptions_user_idx")
  @@map("subscriptions")
}

model BillingEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stripeEventId String    @unique @map("stripe_event_id") @db.VarChar(255)
  type          String    @db.VarChar(100)
  payload       Json
  processedAt   DateTime? @map("processed_at") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("billing_events")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId], map: "audit_log_actor_idx")
  @@map("audit_log")
}

model ModerationEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  anonIdentifier String?  @map("anon_identifier") @db.VarChar(255)
  sessionId      String?  @map("session_id") @db.Uuid
  tier           String   @db.VarChar(20)
  category       String   @db.VarChar(100)
  flaggedText    String   @map("flagged_text") @db.Text
  actionTaken    String   @map("action_taken") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user    User?          @relation(fields: [userId], references: [id])
  session DesignSession? @relation(fields: [sessionId], references: [id])

  @@index([userId], map: "moderation_events_user_idx")
  @@index([anonIdentifier], map: "moderation_events_anon_idx")
  @@index([createdAt], map: "moderation_events_created_idx")
  @@map("moderation_events")
}

/// Editable usage limits per plan ("guest" | "free" | "paid"). Changed from the admin panel, so a limit
/// change never needs a deploy. 0 in maxInFlightSessions means "no cap".
model PlanLimit {
  plan                String   @id @db.VarChar(20)
  messagesPerSession  Int      @map("messages_per_session")
  maxInFlightSessions Int      @default(0) @map("max_in_flight_sessions")
  sessionsPerHour     Int      @map("sessions_per_hour")
  updatedBy           String?  @map("updated_by") @db.Uuid
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("plan_limits")
}

// ---------------------------------------------------------------------------------------------
// Prototype Hardware Database (Prototype Hardware Database v3.3, truth file §14) — first slice:
// families, entities, sources and SVG artwork. Table and column names follow §14. Relational
// columns own governance and readiness; metadata_json owns the deep engineering facts. Controlled
// vocabularies are strings checked in SQL (see the migration) and in hardware.schema.ts.
// Entities are never hard-deleted: session versions reference them by hardware_entity_id.
// ---------------------------------------------------------------------------------------------

model ProductFamily {
  productFamilyId           String   @id @map("product_family_id") @db.VarChar(120)
  vendor                    String   @db.VarChar(120)
  familyName                String   @map("family_name") @db.Text
  canonicalGroup            String   @map("canonical_group") @db.VarChar(60)
  /// Set by reviewers (§6.3). Null until then; the resolver falls back to the only eligible member.
  preferredHardwareEntityId String?  @map("preferred_hardware_entity_id") @db.VarChar(64)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  entities HardwareEntity[]

  @@map("product_families")
}

model HardwareEntity {
  hardwareEntityId      String    @id @map("hardware_entity_id") @db.VarChar(64)
  productFamilyId       String    @map("product_family_id") @db.VarChar(120)
  hardwareRevision      String?   @map("hardware_revision") @db.VarChar(60)
  supersedes            String?   @db.VarChar(64)
  supersededBy          String?   @map("superseded_by") @db.VarChar(64)
  forkedFrom            String?   @map("forked_from") @db.VarChar(64)
  /// provisional | confirmed | rejected
  reviewStatus          String    @map("review_status") @db.VarChar(20)
  /// active | nrnd | discontinued | unknown
  lifecycleStatus       String    @map("lifecycle_status") @db.VarChar(20)
  /// shared_library | private_project
  scope                 String    @db.VarChar(20)
  verificationMethod    String    @map("verification_method") @db.VarChar(30)
  recordOrigin          String    @map("record_origin") @db.VarChar(30)
  /// catalog_only | metadata_ready | visual_ready | wiring_ready | needs_review | failed
  assetReadiness        String    @map("asset_readiness") @db.VarChar(20)
  createdBy             String    @map("created_by") @db.VarChar(120)
  /// design_sessions.id for private_project records.
  projectId             String?   @map("project_id") @db.Uuid
  promotedAt            DateTime? @map("promoted_at") @db.Timestamp(6)
  promotedBy            String?   @map("promoted_by") @db.VarChar(120)
  metadataSchemaVersion String    @map("metadata_schema_version") @db.VarChar(10)
  lastVerifiedAt        DateTime? @map("last_verified_at") @db.Timestamp(6)
  /// sha256 of the imported record JSON. Lets a re-import skip unchanged boards and refuse to
  /// silently overwrite changed ones (§4.3).
  contentHash           String    @map("content_hash") @db.VarChar(80)
  metadataJson          Json      @map("metadata_json")
  /// Retrieval vector over a deterministic summary of the canonical facts (plan D4). Written with
  /// raw SQL (Prisma cannot write vector columns); HNSW index in the migration.
  embedding              Unsupported("vector(1536)")?
  embeddingSourceSummary String?   @map("embedding_source_summary") @db.Text
  embeddingModelVersion  String?   @map("embedding_model_version") @db.VarChar(80)
  /// sha256(summary + model): re-embed only when this changes.
  embeddingInputHash     String?   @map("embedding_input_hash") @db.VarChar(80)
  embeddedAt             DateTime? @map("embedded_at") @db.Timestamp(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  family   ProductFamily    @relation(fields: [productFamilyId], references: [productFamilyId])
  project  DesignSession?   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sources  HardwareSource[]
  svgAsset SvgAsset?

  @@index([scope, reviewStatus, assetReadiness], map: "hardware_entities_eligibility_idx")
  @@index([productFamilyId], map: "hardware_entities_family_idx")
  @@index([projectId], map: "hardware_entities_project_idx")
  @@map("hardware_entities")
}

model HardwareSource {
  sourceId           String    @id @default(dbgenerated("gen_random_uuid()")) @map("source_id") @db.Uuid
  hardwareEntityId   String    @map("hardware_entity_id") @db.VarChar(64)
  sourceType         String    @map("source_type") @db.VarChar(30)
  url                String?   @db.Text
  official           Boolean   @default(false)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamp(6)
  lastCheckedAt      DateTime? @map("last_checked_at") @db.Timestamp(6)
  /// Hash only — page content is never stored (§8.4).
  contentFingerprint String?   @map("content_fingerprint") @db.VarChar(100)
  lastHttpStatus     Int?      @map("last_http_status")

  entity HardwareEntity @relation(fields: [hardwareEntityId], references: [hardwareEntityId], onDelete: Cascade)

  @@index([hardwareEntityId], map: "hardware_sources_entity_idx")
  @@map("hardware_sources")
}

/// Review queue (truth file §16, plan ERD 2). Scraped or otherwise machine-sourced hardware never
/// enters the library directly: it waits here until an admin approves (or rejects) it.
model HardwareChangeProposal {
  proposalId                String    @id @default(dbgenerated("gen_random_uuid()")) @map("proposal_id") @db.Uuid
  /// The library entity this would change; null for a board that does not exist yet.
  hardwareEntityId          String?   @map("hardware_entity_id") @db.VarChar(64)
  /// The id inside the candidate record (what approval would create or replace).
  proposedHardwareEntityId  String?   @map("proposed_hardware_entity_id") @db.VarChar(64)
  /// { record, svg, asset? } exactly as the admin upload takes it.
  candidatePayload          Json      @map("candidate_payload")
  /// Top-level record blocks that differ from the current entity (null for a new board).
  diff                      Json?
  /// new_entity | non_structural | engineering_sensitive
  changeClass               String    @map("change_class") @db.VarChar(40)
  /// vendor_agent | user | import | admin
  sourceType                String    @map("source_type") @db.VarChar(30)
  sourceReference           String?   @map("source_reference") @db.Text
  /// pending | approved | rejected | needs_review
  status                    String    @default("pending") @db.VarChar(20)
  validationIssues          Json      @map("validation_issues")
  contentHash               String?   @map("content_hash") @db.VarChar(80)
  proposedBy                String    @map("proposed_by") @db.VarChar(120)
  proposedAt                DateTime  @default(now()) @map("proposed_at") @db.Timestamp(6)
  reviewedBy                String?   @map("reviewed_by") @db.VarChar(120)
  reviewedAt                DateTime? @map("reviewed_at") @db.Timestamp(6)
  reviewNotes               String?   @map("review_notes") @db.Text

  @@index([status, proposedAt], map: "hardware_change_proposals_status_idx")
  @@index([proposedHardwareEntityId], map: "hardware_change_proposals_proposed_idx")
  @@map("hardware_change_proposals")
}

model SvgAsset {
  hardwareEntityId     String    @id @map("hardware_entity_id") @db.VarChar(64)
  fileName             String    @map("file_name") @db.VarChar(120)
  storagePath          String    @map("storage_path") @db.VarChar(255)
  buildStatus          String    @map("build_status") @db.VarChar(20)
  validationStatus     String    @map("validation_status") @db.VarChar(20)
  anchorIds            Json      @map("anchor_ids")
  generationSourceHash String    @map("generation_source_hash") @db.VarChar(100)
  generatedAt          DateTime? @map("generated_at") @db.Timestamp(6)
  approvedBy           String?   @map("approved_by") @db.VarChar(120)
  approvedAt           DateTime? @map("approved_at") @db.Timestamp(6)
  artworkOriginal      Boolean   @default(true) @map("artwork_original")
  /// The sanitized perimeter-v1 SVG. Stored inline until the R2 client exists; storage_path keeps
  /// the R2 key so moving it out later is a data migration, not a contract change.
  svgMarkup            String    @map("svg_markup") @db.Text

  entity HardwareEntity @relation(fields: [hardwareEntityId], references: [hardwareEntityId], onDelete: Cascade)

  @@map("svg_assets")
}

/// Store listing for a library board (plan §22 commerce addendum, ERD 4 `vendor_listings`): one row
/// per product-page URL, holding the latest price and stock read from the page. Keyed by URL so
/// every board and project that links the same page shares one cached check.
model VendorListing {
  listingId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("listing_id") @db.Uuid
  url              String    @unique @db.Text
  storeHost        String    @map("store_host") @db.VarChar(255)
  hardwareEntityId String?   @map("hardware_entity_id") @db.VarChar(64)
  storeSku         String?   @map("store_sku") @db.VarChar(100)
  productName      String?   @map("product_name") @db.VarChar(300)
  /// ok = price read from the page; not_listed = page has no machine-readable price; error = fetch failed
  status           String    @db.VarChar(20)
  price            Decimal?  @db.Decimal(12, 2)
  currency         String?   @db.VarChar(3)
  stockState       String?   @map("stock_state") @db.VarChar(20)
  parseMethod      String?   @map("parse_method") @db.VarChar(20)
  lastError        String?   @map("last_error") @db.VarChar(300)
  checkedAt        DateTime  @map("checked_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  observations ListingObservation[]

  @@index([hardwareEntityId], map: "vendor_listings_entity_idx")
  @@map("vendor_listings")
}

/// Price and stock history for a listing (ERD 4 `listing_observations`): one row per successful check.
model ListingObservation {
  observationId String   @id @default(dbgenerated("gen_random_uuid()")) @map("observation_id") @db.Uuid
  listingId     String   @map("listing_id") @db.Uuid
  price         Decimal  @db.Decimal(12, 2)
  currency      String   @db.VarChar(3)
  stockState    String   @map("stock_state") @db.VarChar(20)
  observedAt    DateTime @default(now()) @map("observed_at") @db.Timestamp(6)

  listing VendorListing @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  @@index([listingId, observedAt], map: "listing_observations_listing_idx")
  @@map("listing_observations")
}


/// Subscribers to service status updates and incident alerts (ESD-8).
/// Durable PostgreSQL store with Redis serving as transient delivery queue.
model StatusSubscriber {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel          String    @default("email") @db.VarChar(20)
  target           String    @db.VarChar(255)
  isVerified       Boolean   @default(false) @map("is_verified")
  verifyToken      String?   @map("verify_token") @db.VarChar(100)
  unsubscribeToken String?   @map("unsubscribe_token") @db.VarChar(100)
  topics           Json?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  unsubscribedAt   DateTime? @map("unsubscribed_at") @db.Timestamp(6)

  @@unique([channel, target], map: "status_subscribers_channel_target_key")
  @@index([target], map: "status_subscribers_target_idx")
  @@index([active], map: "status_subscribers_active_idx")
  @@map("status_subscribers")
}

/// Trusted networks that may reach the internal admin portal (admin.embedo.ai). Managed by
/// product admins at /admin/ingest; enforced by Nginx (VPS sync job) and by the admin API, both
/// reading this table. An empty list allows nobody.
model AdminPortalAllowedIp {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Normalised network, e.g. "203.0.113.7/32" or "2001:db8::/48".
  cidr      String    @unique @db.VarChar(64)
  label     String    @db.VarChar(120)
  enabled   Boolean   @default(true)
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("admin_portal_ip_allowlist")
}

// ---------------------------------------------------------------------------------------------
// EKAB — Track B domain intelligence (Canonical Output & EKAB Ingestion Contract v0.1, §14.1).
// Releases are immutable: corrections arrive as new releases whose records supersede old ones.
// Structured rows are the source of truth; the record embedding is only a retrieval index.
// Vocabularies are mirrored in src/modules/ekab/ekab.constants.ts (CHECK constraints in SQL).
// ---------------------------------------------------------------------------------------------

/// One Track B batch release (knowledge_release). The canonical JSON and supporting files are
/// kept exactly as received for audit and reprocessing.
model EkabRelease {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releaseId        String    @map("release_id") @db.VarChar(80)
  schemaVersion    String?   @map("schema_version") @db.VarChar(40)
  domainId         String?   @map("domain_id") @db.VarChar(4)
  domainName       String?   @map("domain_name") @db.VarChar(80)
  batchId          String?   @map("batch_id") @db.VarChar(120)
  /// As declared by the worker/governance: DRAFT | QA_PENDING | REVISION_REQUIRED | APPROVED_FOR_INGESTION | REJECTED | SUPERSEDED
  releaseStatus    String?   @map("release_status") @db.VarChar(30)
  /// Ours: RECEIVED | SCHEMA_VALID | STAGED | QUARANTINED | PROMOTED | REJECTED | SUPERSEDED
  ingestionState   String    @map("ingestion_state") @db.VarChar(20)
  /// sha256 of the canonical JSON (key order independent).
  contentHash      String    @map("content_hash") @db.VarChar(80)
  generatedAt      DateTime? @map("generated_at") @db.Timestamp(6)
  sourceSnapshotId String?   @map("source_snapshot_id") @db.VarChar(120)
  producer         Json?
  governance       Json?
  declaredCounts   Json?     @map("declared_counts")
  computedCounts   Json?     @map("computed_counts")
  validationIssues Json      @map("validation_issues")
  /// Automatic staging round-trip check (contract §18 step 11): { passed, checked, failures[] }.
  roundTrip        Json?     @map("round_trip")
  payload          Json
  sourceManifest   Json?     @map("source_manifest")
  gapRegistry      Json?     @map("gap_registry")
  qaReport         Json?     @map("qa_report")
  completionReport Json?     @map("completion_report")
  receivedBy       String    @map("received_by") @db.VarChar(120)
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamp(6)
  stagedAt         DateTime? @map("staged_at") @db.Timestamp(6)
  decidedBy        String?   @map("decided_by") @db.VarChar(120)
  decidedAt        DateTime? @map("decided_at") @db.Timestamp(6)
  decisionNotes    String?   @map("decision_notes") @db.Text

  records       EkabRecord[]
  relationships EkabRelationship[]
  gaps          EkabGap[]
  handoffs      EkabHandoff[]
  events        EkabIngestionEvent[]

  @@index([domainId, ingestionState], map: "ekab_releases_domain_state_idx")
  @@index([releaseId], map: "ekab_releases_release_id_idx")
  @@map("ekab_releases")
}

/// One canonical B1–B10 record as delivered in one release (domain_record).
model EkabRecord {
  id                    String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releasePk             String                       @map("release_pk") @db.Uuid
  releaseId             String                       @map("release_id") @db.VarChar(80)
  recordId              String                       @map("record_id") @db.VarChar(120)
  recordRevision        Int?                         @map("record_revision")
  recordType            String?                      @map("record_type") @db.VarChar(40)
  domainId              String?                      @map("domain_id") @db.VarChar(4)
  topic                 String?                      @db.Text
  title                 String?                      @db.Text
  normalizedStatement   String?                      @map("normalized_statement") @db.Text
  /// SOURCE_BASED | DERIVED
  origin                String?                      @db.VarChar(20)
  /// VERIFIED | CONDITIONAL | UNRESOLVED | REJECTED
  trustState            String?                      @map("trust_state") @db.VarChar(20)
  /// HIGH | MEDIUM | LOW
  confidence            String?                      @db.VarChar(10)
  /// ACTIVE | SUPERSEDED | RETIRED
  lifecycleStatus       String?                      @map("lifecycle_status") @db.VarChar(20)
  supersedes            String?                      @db.VarChar(120)
  supersededByPk        String?                      @map("superseded_by_pk") @db.Uuid
  applicability         Json
  content               Json
  evidenceRefs          String[]                     @map("evidence_refs")
  relationshipRefs      String[]                     @map("relationship_refs")
  tags                  String[]
  qa                    Json?
  /// The record exactly as received.
  raw                   Json
  quarantined           Boolean                      @default(false)
  quarantineReasons     Json?                        @map("quarantine_reasons")
  embedding             Unsupported("vector(1536)")?
  embeddingModelVersion String?                      @map("embedding_model_version") @db.VarChar(80)
  embeddingInputHash    String?                      @map("embedding_input_hash") @db.VarChar(80)
  embeddedAt            DateTime?                    @map("embedded_at") @db.Timestamp(6)
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamp(6)

  release    EkabRelease           @relation(fields: [releasePk], references: [id], onDelete: Restrict)
  evidence   EkabRecordEvidence[]
  conditions EkabRecordCondition[]

  @@unique([releasePk, recordId], map: "ekab_records_release_record_key")
  @@index([recordId, recordRevision], map: "ekab_records_record_idx")
  @@index([domainId, lifecycleStatus, trustState], map: "ekab_records_reasoning_idx")
  @@map("ekab_records")
}

/// Canonical source identity (evidence_source), shared across releases (upserted by source_id).
model EkabEvidenceSource {
  sourceId       String   @id @map("source_id") @db.VarChar(160)
  sourceType     String?  @map("source_type") @db.VarChar(30)
  publisher      String?  @db.VarChar(300)
  title          String?  @db.Text
  documentId     String?  @map("document_id") @db.VarChar(200)
  url            String?  @db.Text
  accessState    String?  @map("access_state") @db.VarChar(30)
  firstReleaseId String   @map("first_release_id") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  links EkabRecordEvidence[]

  @@map("ekab_evidence_sources")
}

/// Record ↔ evidence link with the revision, locator and support type that apply to this claim.
model EkabRecordEvidence {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordPk       String  @map("record_pk") @db.Uuid
  evidenceId     String  @map("evidence_id") @db.VarChar(160)
  sourceId       String  @map("source_id") @db.VarChar(160)
  sourceRevision String? @map("source_revision") @db.VarChar(120)
  locator        String? @db.Text
  supportType    String? @map("support_type") @db.VarChar(30)
  retrievedAt    String? @map("retrieved_at") @db.VarChar(40)

  record EkabRecord         @relation(fields: [recordPk], references: [id], onDelete: Cascade)
  source EkabEvidenceSource @relation(fields: [sourceId], references: [sourceId], onDelete: Restrict)

  @@index([recordPk], map: "ekab_record_evidence_record_idx")
  @@index([sourceId], map: "ekab_record_evidence_source_idx")
  @@map("ekab_record_evidence")
}

/// Structured applicability (record_condition): one row per applies_to / excludes / condition.
model EkabRecordCondition {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordPk String @map("record_pk") @db.Uuid
  /// applies_to | excludes | condition
  kind     String @db.VarChar(20)
  text     String @db.Text
  value    Json?

  record EkabRecord @relation(fields: [recordPk], references: [id], onDelete: Cascade)

  @@index([recordPk], map: "ekab_record_conditions_record_idx")
  @@map("ekab_record_conditions")
}

/// Typed relation among domain records (record_relationship).
model EkabRelationship {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releasePk      String  @map("release_pk") @db.Uuid
  relationshipId String  @map("relationship_id") @db.VarChar(120)
  type           String? @db.VarChar(40)
  fromRecordId   String? @map("from_record_id") @db.VarChar(120)
  toRecordId     String? @map("to_record_id") @db.VarChar(120)
  targetConcept  String? @map("target_concept") @db.Text
  conditions     Json?
  raw            Json

  release EkabRelease @relation(fields: [releasePk], references: [id], onDelete: Restrict)

  @@unique([releasePk, relationshipId], map: "ekab_relationships_release_rel_key")
  @@index([fromRecordId], map: "ekab_relationships_from_idx")
  @@map("ekab_relationships")
}

/// Gap / Conflict Registry entry (gap_conflict).
model EkabGap {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releasePk            String   @map("release_pk") @db.Uuid
  gapId                String   @map("gap_id") @db.VarChar(120)
  domainId             String?  @map("domain_id") @db.VarChar(4)
  batchId              String?  @map("batch_id") @db.VarChar(120)
  topic                String?  @db.Text
  question             String?  @db.Text
  gapType              String?  @map("gap_type") @db.VarChar(30)
  severity             String?  @db.VarChar(10)
  status               String?  @db.VarChar(25)
  sourceRefs           String[] @map("source_refs")
  resolutionRecordRefs String[] @map("resolution_record_refs")
  notes                String?  @db.Text
  raw                  Json

  release EkabRelease @relation(fields: [releasePk], references: [id], onDelete: Restrict)

  @@unique([releasePk, gapId], map: "ekab_gaps_release_gap_key")
  @@map("ekab_gaps")
}

/// Cross-domain handoff work item (cross_domain_handoff).
model EkabHandoff {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releasePk            String   @map("release_pk") @db.Uuid
  handoffId            String   @map("handoff_id") @db.VarChar(120)
  sourceDomain         String?  @map("source_domain") @db.VarChar(10)
  targetDomain         String?  @map("target_domain") @db.VarChar(10)
  sourceRecordRefs     String[] @map("source_record_refs")
  question             String?  @db.Text
  reason               String?  @db.VarChar(60)
  priority             String?  @db.VarChar(20)
  blocking             Boolean  @default(false)
  status               String?  @db.VarChar(20)
  resolutionRecordRefs String[] @map("resolution_record_refs")
  raw                  Json

  release EkabRelease @relation(fields: [releasePk], references: [id], onDelete: Restrict)

  @@unique([releasePk, handoffId], map: "ekab_handoffs_release_handoff_key")
  @@map("ekab_handoffs")
}

/// Staging / promotion / rejection audit trail (ingestion_event).
model EkabIngestionEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  releasePk String   @map("release_pk") @db.Uuid
  state     String   @db.VarChar(20)
  actor     String   @db.VarChar(120)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  release EkabRelease @relation(fields: [releasePk], references: [id], onDelete: Restrict)

  @@index([releasePk, createdAt], map: "ekab_ingestion_events_release_idx")
  @@map("ekab_ingestion_events")
}

/// Websites the source scraper may read, managed by admins. RESTRICTED hosts (e.g. paywalled
/// standards) are never fetched: only their bibliographic identity is recorded, as a gap.
model EkabSourceDomain {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Exact host ("www.rfc-editor.org") or a suffix starting with a dot (".ti.com").
  host              String   @unique @db.VarChar(255)
  publisher         String   @db.VarChar(300)
  /// Contract §7 source_type used for documents from this host unless the admin overrides it.
  defaultSourceType String   @map("default_source_type") @db.VarChar(30)
  /// PUBLIC | LICENSED_REFERENCE_ONLY | RESTRICTED
  accessState       String   @map("access_state") @db.VarChar(30)
  enabled           Boolean  @default(true)
  notes             String?  @db.Text
  createdBy         String   @map("created_by") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("ekab_source_domains")
}

/// One scrape run for a coverage batch (e.g. B1-C02 CAN family): fetch the given URLs and extract
/// candidate statements deterministically (no AI). Candidates become records only after review.
model EkabScrapeJob {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId   String    @map("domain_id") @db.VarChar(4)
  batchCode  String    @map("batch_code") @db.VarChar(40)
  title      String    @db.VarChar(300)
  /// queued | running | ready | failed | built
  status     String    @db.VarChar(20)
  /// [{ url, sourceType?, title?, documentId?, revision? }] as entered by the admin.
  requested  Json
  summary    Json?
  error      String?   @db.Text
  /// release_id of the release built from this job's accepted candidates.
  releaseId  String?   @map("release_id") @db.VarChar(80)
  createdBy  String    @map("created_by") @db.VarChar(120)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(6)

  documents  EkabScrapedDocument[]
  candidates EkabCandidate[]

  @@index([status, createdAt], map: "ekab_scrape_jobs_status_idx")
  @@map("ekab_scrape_jobs")
}

/// One fetched (or refused) source document of a scrape job. Only extracted passages are kept,
/// never the full document text.
model EkabScrapedDocument {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  url         String    @db.Text
  finalUrl    String?   @map("final_url") @db.Text
  host        String?   @db.VarChar(255)
  /// fetched | blocked | failed
  status      String    @db.VarChar(20)
  blockReason String?   @map("block_reason") @db.Text
  httpStatus  Int?      @map("http_status")
  contentType String?   @map("content_type") @db.VarChar(120)
  sourceId    String?   @map("source_id") @db.VarChar(160)
  sourceType  String?   @map("source_type") @db.VarChar(30)
  publisher   String?   @db.VarChar(300)
  title       String?   @db.Text
  documentId  String?   @map("document_id") @db.VarChar(200)
  revision    String?   @db.VarChar(120)
  accessState String?   @map("access_state") @db.VarChar(30)
  fingerprint String?   @db.VarChar(80)
  pageCount   Int?      @map("page_count")
  retrievedAt DateTime? @map("retrieved_at") @db.Timestamp(6)

  job        EkabScrapeJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidates EkabCandidate[]

  @@index([jobId], map: "ekab_scraped_documents_job_idx")
  @@map("ekab_scraped_documents")
}

/// A verbatim passage the scraper found (normative sentence or parameter-table row) waiting for
/// an admin to accept (optionally editing it), or reject it.
model EkabCandidate {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId               String    @map("job_id") @db.Uuid
  documentPk          String    @map("document_pk") @db.Uuid
  /// normative_sentence | parameter_row
  kind                String    @db.VarChar(30)
  /// MUST | SHALL | REQUIRED | SHOULD | RECOMMENDED | MAY … (normative sentences only)
  keyword             String?   @db.VarChar(20)
  /// Page / section / table locator inside the document.
  locator             String    @db.Text
  section             String?   @db.Text
  /// The exact text found in the source.
  excerpt             String    @db.Text
  /// Parsed parameter row: { parameter, min, typ, max, unit, conditions }.
  values              Json?
  suggestedRecordType String    @map("suggested_record_type") @db.VarChar(40)
  /// pending | accepted | rejected
  status              String    @default("pending") @db.VarChar(20)
  /// The reviewer's version (record_type, title, topic, normalized_statement, trust_state, …).
  edited              Json?
  reviewedBy          String?   @map("reviewed_by") @db.VarChar(120)
  reviewedAt          DateTime? @map("reviewed_at") @db.Timestamp(6)

  job      EkabScrapeJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  document EkabScrapedDocument @relation(fields: [documentPk], references: [id], onDelete: Cascade)

  @@index([jobId, status], map: "ekab_candidates_job_status_idx")
  @@map("ekab_candidates")
}
